@inherits LayoutComponentBase

<div class="auth-shell">
    <div class="auth-background" aria-hidden="true">
        <span class="auth-glow auth-glow-one"></span>
        <span class="auth-glow auth-glow-two"></span>
        <span class="auth-grid-pattern"></span>
    </div>

    <section class="auth-showcase">
        <a class="auth-brand" href="/">
            <span class="auth-brand-logo">Rx</span>

            <span class="auth-brand-copy">
                <strong>PharmaCare</strong>
                <small>PRO</small>
            </span>
        </a>

        <div class="auth-showcase-copy">
            <span class="auth-showcase-kicker">
                <i></i>
                SECURE PHARMACY WORKSPACE
            </span>

            <h1>
                Your pharmacy,
                <span>protected and connected.</span>
            </h1>

            <p>
                Access medicines, purchases, inventory, prescriptions,
                customer accounts and daily sales through one secure system.
            </p>

            <div class="auth-benefit-grid">
                <article>
                    <span>✓</span>

                    <div>
                        <strong>Protected pharmacy data</strong>
                        <small>
                            Business pages require an authenticated account.
                        </small>
                    </div>
                </article>

                <article>
                    <span>✓</span>

                    <div>
                        <strong>Live Supabase records</strong>
                        <small>
                            Sales and inventory remain synchronized.
                        </small>
                    </div>
                </article>

                <article>
                    <span>✓</span>

                    <div>
                        <strong>FEFO stock control</strong>
                        <small>
                            Medicine batches are allocated by expiry.
                        </small>
                    </div>
                </article>
            </div>
        </div>

        <div class="auth-visual" aria-hidden="true">
            <span class="auth-orbit auth-orbit-one"></span>
            <span class="auth-orbit auth-orbit-two"></span>
            <span class="auth-orbit auth-orbit-three"></span>

            <div class="auth-medical-mark">
                <span></span>
                <span></span>
            </div>

            <div class="auth-floating-card auth-floating-card-one">
                <span class="auth-floating-icon">▣</span>

                <div>
                    <strong>Live sales</strong>
                    <small>Securely synchronized</small>
                </div>

                <i></i>
            </div>

            <div class="auth-floating-card auth-floating-card-two">
                <span class="auth-floating-icon">Rx</span>

                <div>
                    <strong>Inventory</strong>
                    <small>FEFO protected</small>
                </div>
            </div>
        </div>

        <div class="auth-showcase-footer">
            <span>
                <i></i>
                Supabase PostgreSQL connected
            </span>

            <small>PharmaCare Pro</small>
        </div>
    </section>

    <main class="auth-main">
        <a class="auth-mobile-brand" href="/">
            <span>Rx</span>

            <div>
                <strong>PharmaCare</strong>
                <small>PRO</small>
            </div>
        </a>

        <section class="auth-card">
            @Body
        </section>

        <div class="auth-security-footer">
            <span>⌾</span>

            <p>
                Protected authentication · Encrypted connection ·
                Secure pharmacy workspace
            </p>
        </div>
    </main>
</div>
