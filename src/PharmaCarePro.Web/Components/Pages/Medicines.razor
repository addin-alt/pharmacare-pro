@page "/medicines"

<PageTitle>Medicines | PharmaCare Pro</PageTitle>

<div class="page-heading module-heading">
    <div>
        <span class="eyebrow">PHARMACARE PRO MODULE</span>
        <h1>Medicines</h1>
        <p>Manage the complete pharmacy medicine catalog.</p>
    </div>

    <a class="button button-primary" href="">
        Return to dashboard
    </a>
</div>

<section class="module-intro-card">
    <div class="module-large-icon">✚</div>

    <div class="module-intro-content">
        <span class="module-status">FOUNDATION READY</span>
        <h2>Medicines module</h2>
        <p>
            The interface foundation is ready. Database entities, forms,
            validation and operational workflows will be implemented in
            the next development stages.
        </p>

        <div class="module-feature-grid">
            <div class="module-feature">
                <span>✓</span>
                <p>Brand and generic medicine information</p>
            </div>
            <div class="module-feature">
                <span>✓</span>
                <p>Strength, dosage form and manufacturer</p>
            </div>
            <div class="module-feature">
                <span>✓</span>
                <p>Barcode, pricing and tax configuration</p>
            </div>
            <div class="module-feature">
                <span>✓</span>
                <p>Prescription and storage requirements</p>
            </div>
        </div>
    </div>
</section>

<section class="dashboard-panel module-next-panel">
    <div class="panel-heading">
        <div>
            <h2>Next implementation stage</h2>
            <p>This module will be connected to Supabase PostgreSQL.</p>
        </div>
    </div>

    <div class="module-next-steps">
        <span>Database entities</span>
        <span>Validation rules</span>
        <span>Create and edit forms</span>
        <span>Search and filtering</span>
        <span>Role permissions</span>
        <span>Automated tests</span>
    </div>
</section>
