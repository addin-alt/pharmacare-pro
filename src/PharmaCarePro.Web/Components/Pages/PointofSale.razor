@page "/pos"
@page "/pos/{RequestedPrescriptionId:guid}"
@using Microsoft.EntityFrameworkCore
@using PharmaCarePro.Application.Inventory
@using PharmaCarePro.Domain.Entities
@using PharmaCarePro.Web.Data
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Point of Sale | PharmaCare Pro</PageTitle>

<div class="page-heading module-heading">
    <div>
        <span class="eyebrow">PHARMACY CHECKOUT</span>
        <h1>Point of Sale</h1>
        <p>Sell medicines using FEFO batch allocation and live inventory.</p>
    </div>

    <a class="button button-secondary" href="">
        Return to dashboard
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="form-status pos-status
         @(statusIsError ? "status-error" : "status-success")">
        <span>@statusMessage</span>

        @if (!statusIsError &&
            lastCompletedSaleId.HasValue)
        {
            <a class="pos-invoice-link"
               href="@($"/sales/{lastCompletedSaleId.Value}/invoice")">
                View printable invoice
            </a>
        }
    </div>
}

<section class="pos-summary-grid">
    <article class="pos-summary-card">
        <span>Available medicines</span>
        <strong>@catalog.Count</strong>
    </article>

    <article class="pos-summary-card">
        <span>Cart quantity</span>
        <strong>@CartQuantity</strong>
    </article>

    <article class="pos-summary-card">
        <span>Grand total</span>
        <strong>৳@GrandTotal.ToString("N2")</strong>
    </article>

    <article class="pos-summary-card">
        <span>Amount due</span>
        <strong>৳@DueAmount.ToString("N2")</strong>
    </article>
</section>

<div class="pos-workspace">
    <section class="dashboard-panel">
        <div class="panel-heading">
            <div>
                <h2>Medicine catalog</h2>
                <p>Select a medicine to add it to the sale.</p>
            </div>

            <a href="inventory">Manage inventory</a>
        </div>

        <input class="pos-search"
               type="search"
               @bind="searchText"
               @bind:event="oninput"
               placeholder="Search brand, generic, SKU or barcode..." />

        @if (isLoading)
        {
            <div class="medicine-empty-state">
                <strong>Loading available medicines...</strong>
            </div>
        }
        else if (!FilteredCatalog.Any())
        {
            <div class="medicine-empty-state">
                <span>Rx</span>
                <strong>No available medicine found</strong>
                <p>Receive usable inventory before making a sale.</p>
            </div>
        }
        else
        {
            <div class="pos-product-grid">
                @foreach (var medicine in FilteredCatalog)
                {
                    <article class="pos-product-card" @key="medicine.Id">
                        <div class="pos-product-heading">
                            <span class="medicine-table-icon">Rx</span>
                            <span>@medicine.AvailableQuantity units</span>
                        </div>

                        <strong>@medicine.BrandName</strong>

                        <small>
                            @medicine.GenericName ·
                            @medicine.Strength ·
                            @medicine.DosageForm
                        </small>

                        <div class="pos-product-price">
                            <span>Starting price</span>
                            <strong>৳@medicine.Price.ToString("N2")</strong>
                        </div>

                        <button class="button button-primary"
                                type="button"
                                disabled="@isProcessing"
                                @onclick="() => AddMedicineAsync(medicine.Id)">
                            Add to cart
                        </button>
                    </article>
                }
            </div>
        }
    </section>

    <aside class="dashboard-panel pos-cart-panel">
        <div class="panel-heading">
            <div>
                <h2>Current sale</h2>
                <p>@cart.Count medicine lines</p>
            </div>

            @if (cart.Count > 0)
            {
                <button class="pos-text-button pos-danger-button"
                        type="button"
                        @onclick="ClearCart">
                    Clear cart
                </button>
            }
        </div>

        @if (cart.Count == 0)
        {
            <div class="medicine-empty-state pos-empty-cart">
                <span>▣</span>
                <strong>The cart is empty</strong>
                <p>Click Add to cart beside Napa.</p>
            </div>
        }
        else
        {
            <div class="pos-cart-lines">
                @foreach (var line in cart)
                {
                    <article class="pos-cart-line" @key="line.MedicineId">
                        <div class="pos-cart-line-heading">
                            <div>
                                <strong>@line.BrandName</strong>
                                <small>
                                    @line.GenericName · @line.Strength
                                </small>
                            </div>

                            <strong>৳@line.Total.ToString("N2")</strong>
                        </div>

                        <div class="pos-cart-actions">
                            <div class="pos-quantity-control">
                                <button type="button"
                                        disabled="@isProcessing"
                                        @onclick="() => ChangeQuantityAsync(
                                            line.MedicineId,
                                            -1)">
                                    −
                                </button>

                                <span>@line.Quantity</span>

                                <button type="button"
                                        disabled="@(
                                            isProcessing ||
                                            (line.MaximumQuantity.HasValue &&
                                             line.Quantity >=
                                             line.MaximumQuantity.Value))"
                                        @onclick="() => ChangeQuantityAsync(
                                            line.MedicineId,
                                            1)">
                                    +
                                </button>
                            </div>

                            <button class="pos-text-button pos-danger-button"
                                    type="button"
                                    @onclick="() => RemoveLine(line.MedicineId)">
                                Remove
                            </button>
                        </div>

                        <small class="pos-allocation">
                            FEFO:
                            @string.Join(
                                " · ",
                                line.Allocations.Select(
                                    allocation =>
                                        $"{allocation.BatchNumber}: {allocation.Quantity}"))
                        </small>

                        @if (line.PrescriptionItemId.HasValue)
                        {
                            <small class="pos-allocation">
                                Prescription limit:
                                @line.MaximumQuantity unit(s)
                            </small>
                        }
                    </article>
                }
            </div>
        }

        <div class="pos-form-grid">
            <div class="form-field pos-customer-selector">
                <label>Active prescription</label>

                <select value="@selectedPrescriptionId"
                        @onchange="HandlePrescriptionSelectionAsync">
                    <option value="@Guid.Empty">
                        No prescription
                    </option>

                    @foreach (var prescription in prescriptions)
                    {
                        <option value="@prescription.Id">
                            @prescription.PrescriptionNumber ·
                            @prescription.PatientName ·
                            @prescription.RemainingQuantity unit(s)
                        </option>
                    }
                </select>
            </div>

            @if (SelectedPrescription is
                PrescriptionOption selectedPrescription)
            {
                <div class="pos-customer-card">
                    <div>
                        <span>Prescription</span>

                        <strong>
                            @selectedPrescription.PrescriptionNumber
                        </strong>
                    </div>

                    <div>
                        <span>Prescriber</span>

                        <strong>
                            @selectedPrescription.PrescriberName
                        </strong>
                    </div>

                    <div>
                        <span>Remaining quantity</span>

                        <strong>
                            @selectedPrescription.RemainingQuantity
                        </strong>
                    </div>

                    <div>
                        <span>Valid until</span>

                        <strong>
                            @(selectedPrescription.ValidUntil.HasValue
                                ? selectedPrescription.ValidUntil.Value
                                    .ToString("dd MMM yyyy")
                                : "Not limited")
                        </strong>
                    </div>
                </div>
            }

            <div class="form-field pos-customer-selector">
                <label>Registered customer</label>
                <select value="@selectedCustomerId"
                        disabled="@(
                            selectedPrescriptionId != Guid.Empty)"
                        @onchange="HandleCustomerSelection">
                    <option value="@Guid.Empty">
                        Walk-in customer
                    </option>

                    @foreach (var customer in customers)
                    {
                        <option value="@customer.Id">
                            @customer.CustomerCode ·
                            @customer.Name
                            @(string.IsNullOrWhiteSpace(customer.Phone)
                                ? string.Empty
                                : $" · {customer.Phone}")
                        </option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>Customer name</label>
                <input @bind="customerName"
                       placeholder="Walk-in customer" />
            </div>

            <div class="form-field">
                <label>Phone number</label>
                <input @bind="customerPhone"
                       placeholder="Optional" />
            </div>

            @if (SelectedCustomer is Customer selectedCustomer)
            {
                <div class="pos-customer-card">
                    <div>
                        <span>Customer balance</span>
                        <strong>
                            ৳@selectedCustomer.CurrentBalance.ToString("N2")
                        </strong>
                    </div>

                    <div>
                        <span>Loyalty points</span>
                        <strong>@selectedCustomer.LoyaltyPoints</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        selectedCustomer.Allergies))
                    {
                        <div class="pos-customer-allergy">
                            <span>Allergy warning</span>
                            <strong>@selectedCustomer.Allergies</strong>
                        </div>
                    }
                </div>
            }

            <div class="form-field">
                <label>Discount</label>
                <input type="number"
                       min="0"
                       step="0.01"
                       @bind="discountAmount" />
            </div>

            <div class="form-field">
                <label>Tax</label>
                <input type="number"
                       min="0"
                       step="0.01"
                       @bind="taxAmount" />
            </div>

            <div class="form-field">
                <label>Payment method</label>
                <select @bind="paymentMethod">
                    @foreach (var method in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@method">
                            @FormatPaymentMethod(method)
                        </option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>Amount received</label>
                <input type="number"
                       min="0"
                       step="0.01"
                       @bind="amountReceived" />
            </div>
        </div>

        <button class="pos-full-payment"
                type="button"
                disabled="@(cart.Count == 0)"
                @onclick="SetFullPayment">
            Set full payment
        </button>

        <div class="pos-totals">
            <div>
                <span>Subtotal</span>
                <strong>৳@Subtotal.ToString("N2")</strong>
            </div>

            <div>
                <span>Discount</span>
                <strong>৳@discountAmount.ToString("N2")</strong>
            </div>

            <div>
                <span>Tax</span>
                <strong>৳@taxAmount.ToString("N2")</strong>
            </div>

            <div class="pos-grand-total">
                <span>Grand total</span>
                <strong>৳@GrandTotal.ToString("N2")</strong>
            </div>

            <div>
                <span>Due</span>
                <strong>৳@DueAmount.ToString("N2")</strong>
            </div>

            <div>
                <span>Change</span>
                <strong>৳@ChangeAmount.ToString("N2")</strong>
            </div>
        </div>

        <button class="button button-primary pos-checkout-button"
                type="button"
                disabled="@(cart.Count == 0 || isProcessing)"
                @onclick="CompleteSaleAsync">
            @(isProcessing ? "Completing sale..." : "Complete sale")
        </button>
    </aside>
</div>

@code {
    [Parameter]
    public Guid? RequestedPrescriptionId { get; set; }

    private List<MedicineOption> catalog = [];
    private List<Customer> customers = [];
    private List<PrescriptionOption> prescriptions = [];

    private readonly List<CartLine> cart = [];

    private string searchText = string.Empty;

    private Guid selectedCustomerId = Guid.Empty;
    private Guid selectedPrescriptionId = Guid.Empty;

    private string? customerName;
    private string? customerPhone;
    private string? statusMessage;

    private Guid? lastCompletedSaleId;

    private decimal discountAmount;
    private decimal taxAmount;
    private decimal amountReceived;

    private PaymentMethod paymentMethod = PaymentMethod.Cash;

    private bool statusIsError;
    private bool isLoading = true;
    private bool isProcessing;

    private Customer? SelectedCustomer =>
        customers.SingleOrDefault(
            customer => customer.Id == selectedCustomerId);

    private PrescriptionOption? SelectedPrescription =>
        prescriptions.SingleOrDefault(
            prescription =>
                prescription.Id == selectedPrescriptionId);

    private IEnumerable<MedicineOption> FilteredCatalog
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return catalog;
            }

            var search = searchText.Trim();

            return catalog.Where(medicine =>
                medicine.BrandName.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                medicine.GenericName.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                medicine.Sku.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ||
                (medicine.Barcode?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private int CartQuantity =>
        cart.Sum(line => line.Quantity);

    private decimal Subtotal =>
        Math.Round(cart.Sum(line => line.Total), 2);

    private decimal GrandTotal =>
        Math.Max(
            0,
            Math.Round(
                Subtotal - discountAmount + taxAmount,
                2));

    private decimal DueAmount =>
        Math.Max(
            0,
            Math.Round(
                GrandTotal - amountReceived,
                2));

    private decimal ChangeAmount =>
        Math.Max(
            0,
            Math.Round(
                amountReceived - GrandTotal,
                2));

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();

        if (RequestedPrescriptionId.HasValue)
        {
            await SelectPrescriptionAsync(
                RequestedPrescriptionId.Value);
        }
    }

    private async Task LoadCatalogAsync()
    {
        isLoading = true;

        using var scope = ScopeFactory.CreateScope();

        var database = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        var today = DateTime.UtcNow.Date;

        var medicines = await database.Medicines
            .AsNoTracking()
            .Where(medicine => medicine.IsActive)
            .Include(medicine => medicine.Batches.Where(batch =>
                batch.AvailableQuantity > 0 &&
                !batch.IsQuarantined &&
                batch.ExpiryDate >= today))
            .OrderBy(medicine => medicine.BrandName)
            .ThenBy(medicine => medicine.Strength)
            .ToListAsync();

        catalog = medicines
            .Select(medicine =>
            {
                var batches = medicine.Batches
                    .OrderBy(batch => batch.ExpiryDate)
                    .ThenBy(batch => batch.CreatedAtUtc)
                    .ToList();

                return new MedicineOption(
                    medicine.Id,
                    medicine.BrandName,
                    medicine.GenericName,
                    medicine.Strength,
                    medicine.DosageForm,
                    medicine.Sku,
                    medicine.Barcode,
                    batches.Sum(batch => batch.AvailableQuantity),
                    batches.FirstOrDefault()?.SellingPrice ??
                        medicine.SellingPrice);
            })
            .Where(medicine => medicine.AvailableQuantity > 0)
            .ToList();

        customers = await database.Customers
            .AsNoTracking()
            .Where(customer => customer.IsActive)
            .OrderBy(customer => customer.Name)
            .ToListAsync();

        var prescriptionRecords =
            await database.Prescriptions
                .AsNoTracking()
                .Include(prescription =>
                    prescription.Customer)
                .Include(prescription =>
                    prescription.Items)
                .Where(prescription =>
                    (prescription.Status ==
                        PrescriptionStatus.Active ||
                     prescription.Status ==
                        PrescriptionStatus.PartiallyDispensed) &&
                    prescription.IssuedDate <= today &&
                    (!prescription.ValidUntil.HasValue ||
                     prescription.ValidUntil.Value >= today) &&
                    prescription.Customer != null &&
                    prescription.Customer.IsActive &&
                    prescription.Items.Any(item =>
                        item.QuantityDispensed <
                        item.QuantityPrescribed))
                .OrderBy(prescription =>
                    prescription.ValidUntil)
                .ThenByDescending(prescription =>
                    prescription.CreatedAtUtc)
                .ToListAsync();

        prescriptions = prescriptionRecords
            .Select(prescription =>
                new PrescriptionOption(
                    prescription.Id,
                    prescription.PrescriptionNumber,
                    prescription.CustomerId,
                    prescription.PatientName,
                    prescription.PatientPhone,
                    prescription.PrescriberName,
                    prescription.ValidUntil,
                    prescription.Items
                        .Where(item =>
                            item.QuantityDispensed <
                            item.QuantityPrescribed)
                        .OrderBy(item =>
                            item.MedicineName)
                        .Select(item =>
                            new PrescriptionLineOption(
                                item.Id,
                                item.MedicineId,
                                item.MedicineName,
                                item.QuantityPrescribed,
                                item.QuantityDispensed))
                        .ToList()))
            .Where(prescription =>
                prescription.Items.Count > 0)
            .ToList();

        isLoading = false;
    }

    private async Task HandlePrescriptionSelectionAsync(
        ChangeEventArgs eventArgs)
    {
        if (!Guid.TryParse(
            eventArgs.Value?.ToString(),
            out var prescriptionId))
        {
            prescriptionId = Guid.Empty;
        }

        await SelectPrescriptionAsync(prescriptionId);
    }

    private async Task SelectPrescriptionAsync(
        Guid prescriptionId)
    {
        cart.Clear();

        selectedPrescriptionId = Guid.Empty;
        selectedCustomerId = Guid.Empty;

        customerName = null;
        customerPhone = null;

        discountAmount = 0;
        taxAmount = 0;
        amountReceived = 0;

        lastCompletedSaleId = null;
        statusMessage = null;
        statusIsError = false;

        if (prescriptionId == Guid.Empty)
        {
            return;
        }

        var prescription = prescriptions
            .SingleOrDefault(item =>
                item.Id == prescriptionId);

        if (prescription is null)
        {
            statusIsError = true;
            statusMessage =
                "The selected prescription is no longer active.";
            return;
        }

        selectedPrescriptionId = prescription.Id;
        selectedCustomerId = prescription.CustomerId;

        var customer = SelectedCustomer;

        customerName =
            customer?.Name ??
            prescription.PatientName;

        customerPhone =
            customer?.Phone ??
            prescription.PatientPhone;

        var unavailableMedicines = new List<string>();

        foreach (var prescriptionItem in
            prescription.Items)
        {
            var medicine = catalog.SingleOrDefault(item =>
                item.Id == prescriptionItem.MedicineId);

            if (medicine is null ||
                medicine.AvailableQuantity <= 0)
            {
                unavailableMedicines.Add(
                    prescriptionItem.MedicineName);

                continue;
            }

            var quantityToLoad =
                Math.Min(
                    prescriptionItem.RemainingQuantity,
                    medicine.AvailableQuantity);

            await SetQuantityAsync(
                prescriptionItem.MedicineId,
                quantityToLoad,
                prescriptionItem.Id,
                prescriptionItem.RemainingQuantity);
        }

        if (cart.Count == 0)
        {
            statusIsError = true;
            statusMessage =
                "None of the prescribed medicines currently have " +
                "usable inventory.";

            return;
        }

        statusMessage =
            $"Prescription {prescription.PrescriptionNumber} " +
            $"loaded with {CartQuantity} unit(s).";

        if (unavailableMedicines.Count > 0)
        {
            statusMessage +=
                " Unavailable: " +
                string.Join(
                    ", ",
                    unavailableMedicines) +
                ".";
        }
    }

    private void HandleCustomerSelection(
        ChangeEventArgs eventArgs)
    {
        if (!Guid.TryParse(
            eventArgs.Value?.ToString(),
            out var customerId))
        {
            customerId = Guid.Empty;
        }

        selectedCustomerId = customerId;

        var customer = SelectedCustomer;

        if (customer is null)
        {
            customerName = null;
            customerPhone = null;
            return;
        }

        customerName = customer.Name;
        customerPhone = customer.Phone;
    }

    private async Task AddMedicineAsync(Guid medicineId)
    {
        var existing = cart.SingleOrDefault(
            line => line.MedicineId == medicineId);

        Guid? prescriptionItemId = null;
        int? maximumQuantity = null;

        if (SelectedPrescription is
            PrescriptionOption prescription)
        {
            var prescriptionItem =
                prescription.Items.FirstOrDefault(item =>
                    item.MedicineId == medicineId);

            if (prescriptionItem is null)
            {
                statusIsError = true;
                statusMessage =
                    "This medicine is not included in the selected " +
                    "prescription.";

                return;
            }

            prescriptionItemId = prescriptionItem.Id;
            maximumQuantity =
                prescriptionItem.RemainingQuantity;
        }

        await SetQuantityAsync(
            medicineId,
            (existing?.Quantity ?? 0) + 1,
            prescriptionItemId,
            maximumQuantity);
    }

    private async Task ChangeQuantityAsync(
        Guid medicineId,
        int change)
    {
        var existing = cart.SingleOrDefault(
            line => line.MedicineId == medicineId);

        if (existing is null)
        {
            return;
        }

        var quantity = existing.Quantity + change;

        if (quantity <= 0)
        {
            RemoveLine(medicineId);
            return;
        }

        await SetQuantityAsync(
            medicineId,
            quantity,
            existing.PrescriptionItemId,
            existing.MaximumQuantity);
    }

    private async Task SetQuantityAsync(
        Guid medicineId,
        int quantity,
        Guid? prescriptionItemId = null,
        int? maximumQuantity = null)
    {
        try
        {
            if (maximumQuantity.HasValue &&
                quantity > maximumQuantity.Value)
            {
                throw new InvalidOperationException(
                    "The quantity cannot exceed the remaining " +
                    "prescribed amount.");
            }

            var medicine = catalog.Single(
                item => item.Id == medicineId);

            var allocations = await GetAllocationsAsync(
                medicineId,
                quantity);

            var newLine = new CartLine(
                medicine.Id,
                medicine.BrandName,
                medicine.GenericName,
                medicine.Strength,
                quantity,
                allocations,
                prescriptionItemId,
                maximumQuantity);

            var existing = cart.SingleOrDefault(
                line => line.MedicineId == medicineId);

            if (existing is null)
            {
                cart.Add(newLine);
            }
            else
            {
                cart[cart.IndexOf(existing)] = newLine;
            }

            statusMessage = null;
            statusIsError = false;
        }
        catch (InvalidOperationException exception)
        {
            statusIsError = true;
            statusMessage = exception.Message;
        }
    }

    private async Task<IReadOnlyList<FefoAllocation>>
        GetAllocationsAsync(
            Guid medicineId,
            int quantity)
    {
        using var scope = ScopeFactory.CreateScope();

        var database = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        var today = DateTime.UtcNow.Date;

        var batches = await database.MedicineBatches
            .AsNoTracking()
            .Where(batch =>
                batch.MedicineId == medicineId &&
                batch.AvailableQuantity > 0 &&
                !batch.IsQuarantined &&
                batch.ExpiryDate >= today)
            .OrderBy(batch => batch.ExpiryDate)
            .ThenBy(batch => batch.CreatedAtUtc)
            .ToListAsync();

        return FefoAllocator.Allocate(
            batches.Select(batch =>
                new FefoBatchCandidate(
                    batch.Id,
                    batch.BatchNumber,
                    batch.ExpiryDate,
                    batch.AvailableQuantity,
                    batch.SellingPrice,
                    batch.IsQuarantined)),
            quantity,
            today);
    }

    private void RemoveLine(Guid medicineId)
    {
        cart.RemoveAll(
            line => line.MedicineId == medicineId);
    }

    private void ClearCart()
    {
        cart.Clear();

        selectedCustomerId = Guid.Empty;
        selectedPrescriptionId = Guid.Empty;

        customerName = null;
        customerPhone = null;
        discountAmount = 0;
        taxAmount = 0;
        amountReceived = 0;
        statusMessage = null;
    }

    private void SetFullPayment()
    {
        amountReceived = GrandTotal;
    }

    private async Task CompleteSaleAsync()
    {
        if (cart.Count == 0)
        {
            statusIsError = true;
            statusMessage =
                "Add at least one medicine before completing the sale.";
            return;
        }

        if (discountAmount > Subtotal)
        {
            statusIsError = true;
            statusMessage =
                "Discount cannot exceed the subtotal.";
            return;
        }

        isProcessing = true;
        statusIsError = false;
        statusMessage = null;
        lastCompletedSaleId = null;

        try
        {
            using var scope = ScopeFactory.CreateScope();

            var database = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            await using var transaction =
                await database.Database.BeginTransactionAsync(
                    System.Data.IsolationLevel.Serializable);

            var now = DateTime.UtcNow;

            Prescription? selectedPrescription = null;

            if (selectedPrescriptionId != Guid.Empty)
            {
                selectedPrescription =
                    await database.Prescriptions
                        .Include(prescription =>
                            prescription.Items)
                        .SingleOrDefaultAsync(prescription =>
                            prescription.Id ==
                                selectedPrescriptionId &&
                            (prescription.Status ==
                                PrescriptionStatus.Active ||
                             prescription.Status ==
                                PrescriptionStatus
                                    .PartiallyDispensed) &&
                            prescription.IssuedDate <= now.Date &&
                            (!prescription.ValidUntil.HasValue ||
                             prescription.ValidUntil.Value >=
                                now.Date));

                if (selectedPrescription is null)
                {
                    throw new InvalidOperationException(
                        "The selected prescription is no longer " +
                        "valid for dispensing.");
                }
            }

            var checkoutCustomerId =
                selectedPrescription?.CustomerId ??
                selectedCustomerId;

            Customer? selectedCustomer = null;

            if (checkoutCustomerId != Guid.Empty)
            {
                selectedCustomer = await database.Customers
                    .SingleOrDefaultAsync(customer =>
                        customer.Id == checkoutCustomerId &&
                        customer.IsActive);

                if (selectedCustomer is null)
                {
                    throw new InvalidOperationException(
                        "The selected customer is no longer active.");
                }
            }

            var invoiceNumber =
                $"PCP-{now:yyyyMMddHHmmss}-" +
                $"{Random.Shared.Next(100, 999)}";

            var sale = new Sale
            {
                InvoiceNumber = invoiceNumber,
                CustomerId = selectedCustomer?.Id,
                PrescriptionId = selectedPrescription?.Id,
                CustomerName =
                    selectedCustomer?.Name ??
                    Normalize(customerName),
                CustomerPhone =
                    selectedCustomer?.Phone ??
                    Normalize(customerPhone),
                SoldAtUtc = now,
                DiscountAmount = Math.Round(discountAmount, 2),
                TaxAmount = Math.Round(taxAmount, 2),
                PaymentMethod = paymentMethod,
                CreatedAtUtc = now
            };

            decimal verifiedSubtotal = 0;

            foreach (var cartLine in cart)
            {
                PrescriptionItem? prescriptionItem = null;

                if (selectedPrescription is not null)
                {
                    if (!cartLine.PrescriptionItemId.HasValue)
                    {
                        throw new InvalidOperationException(
                            "Every cart item must belong to the " +
                            "selected prescription.");
                    }

                    prescriptionItem =
                        selectedPrescription.Items
                            .SingleOrDefault(item =>
                                item.Id ==
                                    cartLine
                                        .PrescriptionItemId.Value &&
                                item.MedicineId ==
                                    cartLine.MedicineId);

                    if (prescriptionItem is null)
                    {
                        throw new InvalidOperationException(
                            "A prescribed medicine line could not " +
                            "be verified.");
                    }

                    var remainingQuantity =
                        prescriptionItem
                            .QuantityPrescribed -
                        prescriptionItem
                            .QuantityDispensed;

                    if (cartLine.Quantity >
                        remainingQuantity)
                    {
                        throw new InvalidOperationException(
                            "The sale quantity exceeds the remaining " +
                            "prescribed quantity.");
                    }
                }

                var batches = await database.MedicineBatches
                    .Include(batch => batch.Medicine)
                    .Where(batch =>
                        batch.MedicineId == cartLine.MedicineId &&
                        batch.AvailableQuantity > 0 &&
                        !batch.IsQuarantined &&
                        batch.ExpiryDate >= now.Date)
                    .OrderBy(batch => batch.ExpiryDate)
                    .ThenBy(batch => batch.CreatedAtUtc)
                    .ToListAsync();

                var allocations = FefoAllocator.Allocate(
                    batches.Select(batch =>
                        new FefoBatchCandidate(
                            batch.Id,
                            batch.BatchNumber,
                            batch.ExpiryDate,
                            batch.AvailableQuantity,
                            batch.SellingPrice,
                            batch.IsQuarantined)),
                    cartLine.Quantity,
                    now.Date);

                foreach (var allocation in allocations)
                {
                    var batch = batches.Single(
                        item => item.Id == allocation.BatchId);

                    batch.AvailableQuantity -=
                        allocation.Quantity;

                    batch.UpdatedAtUtc = now;

                    verifiedSubtotal +=
                        allocation.LineTotal;

                    sale.Items.Add(new SaleItem
                    {
                        PrescriptionItemId =
                            prescriptionItem?.Id,
                        MedicineId = batch.MedicineId,
                        MedicineBatchId = batch.Id,
                        BrandName = batch.Medicine!.BrandName,
                        GenericName = batch.Medicine.GenericName,
                        Strength = batch.Medicine.Strength,
                        BatchNumber = batch.BatchNumber,
                        Quantity = allocation.Quantity,
                        UnitCost = batch.PurchasePrice,
                        UnitPrice = allocation.UnitPrice,
                        DiscountAmount = 0,
                        LineTotal = allocation.LineTotal
                    });

                    database.StockMovements.Add(
                        new StockMovement
                        {
                            MedicineBatchId = batch.Id,
                            MovementType =
                                StockMovementType.Sale,
                            QuantityChange =
                                -allocation.Quantity,
                            BalanceAfter =
                                batch.AvailableQuantity,
                            ReferenceNumber =
                                invoiceNumber,
                            Notes =
                                "Stock issued through point of sale.",
                            CreatedAtUtc = now
                        });
                }

                if (prescriptionItem is not null)
                {
                    prescriptionItem.QuantityDispensed +=
                        cartLine.Quantity;
                }
            }

            if (selectedPrescription is not null)
            {
                selectedPrescription.Status =
                    selectedPrescription.Items.All(item =>
                        item.QuantityDispensed >=
                        item.QuantityPrescribed)
                        ? PrescriptionStatus.Dispensed
                        : PrescriptionStatus
                            .PartiallyDispensed;

                selectedPrescription.UpdatedAtUtc = now;
            }

            sale.Subtotal =
                Math.Round(verifiedSubtotal, 2);

            sale.GrandTotal =
                Math.Max(
                    0,
                    Math.Round(
                        sale.Subtotal -
                        sale.DiscountAmount +
                        sale.TaxAmount,
                        2));

            sale.PaidAmount =
                Math.Min(
                    sale.GrandTotal,
                    Math.Max(
                        0,
                        Math.Round(
                            amountReceived,
                            2)));

            sale.DueAmount =
                Math.Round(
                    sale.GrandTotal -
                    sale.PaidAmount,
                    2);

            sale.Status = sale.DueAmount == 0
                ? SaleStatus.Completed
                : sale.PaidAmount > 0
                    ? SaleStatus.PartiallyPaid
                    : SaleStatus.Due;

            if (sale.PaidAmount == 0)
            {
                sale.PaymentMethod = PaymentMethod.Due;
            }

            if (selectedCustomer is not null)
            {
                selectedCustomer.CurrentBalance =
                    Math.Round(
                        selectedCustomer.CurrentBalance +
                        sale.DueAmount,
                        2);

                selectedCustomer.UpdatedAtUtc = now;
            }

            database.Sales.Add(sale);

            await database.SaveChangesAsync();
            await transaction.CommitAsync();

            lastCompletedSaleId = sale.Id;

            var change = ChangeAmount;

            cart.Clear();

            selectedCustomerId = Guid.Empty;
            selectedPrescriptionId = Guid.Empty;

            customerName = null;
            customerPhone = null;
            discountAmount = 0;
            taxAmount = 0;
            amountReceived = 0;

            statusMessage =
                $"Sale completed successfully. " +
                $"Invoice: {invoiceNumber}. " +
                $"Change: ৳{change:N2}";

            await LoadCatalogAsync();
        }
        catch (InvalidOperationException exception)
        {
            statusIsError = true;
            statusMessage = exception.Message;
        }
        catch (DbUpdateException)
        {
            statusIsError = true;
            statusMessage =
                "The sale could not be completed because inventory changed. " +
                "Please try again.";
        }
        catch (Exception exception)
        {
            statusIsError = true;
            statusMessage =
                $"The sale could not be completed: {exception.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private static string FormatPaymentMethod(
        PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.MobileBanking =>
                "Mobile banking",
            PaymentMethod.BankTransfer =>
                "Bank transfer",
            _ => method.ToString()
        };
    }

    private static string? Normalize(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

    private sealed record MedicineOption(
        Guid Id,
        string BrandName,
        string GenericName,
        string Strength,
        string DosageForm,
        string Sku,
        string? Barcode,
        int AvailableQuantity,
        decimal Price);

    private sealed record PrescriptionOption(
        Guid Id,
        string PrescriptionNumber,
        Guid CustomerId,
        string PatientName,
        string? PatientPhone,
        string PrescriberName,
        DateTime? ValidUntil,
        IReadOnlyList<PrescriptionLineOption> Items)
    {
        public int RemainingQuantity =>
            Items.Sum(item =>
                item.RemainingQuantity);
    }

    private sealed record PrescriptionLineOption(
        Guid Id,
        Guid MedicineId,
        string MedicineName,
        int QuantityPrescribed,
        int QuantityDispensed)
    {
        public int RemainingQuantity =>
            Math.Max(
                0,
                QuantityPrescribed -
                QuantityDispensed);
    }

    private sealed record CartLine(
        Guid MedicineId,
        string BrandName,
        string GenericName,
        string Strength,
        int Quantity,
        IReadOnlyList<FefoAllocation> Allocations,
        Guid? PrescriptionItemId,
        int? MaximumQuantity)
    {
        public decimal Total =>
            Math.Round(
                Allocations.Sum(
                    allocation => allocation.LineTotal),
                2);
    }
}
