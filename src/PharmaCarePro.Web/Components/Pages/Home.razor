@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PharmaCarePro.Domain.Entities
@using PharmaCarePro.Web.Data
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard | PharmaCare Pro</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@dashboardDateText</span>
        <h1>@greetingText, @displayName</h1>
        <p>Here is the live operational overview of your pharmacy.</p>
    </div>

    <div class="heading-actions">
        <a class="button button-secondary" href="purchases">
            <span>↓</span>
            Receive stock
        </a>

        <a class="button button-primary" href="pos">
            <span>▣</span>
            New sale
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="form-status status-error">
        @loadError
    </div>
}

<section class="welcome-panel">
    <div class="welcome-copy">
        <span class="welcome-kicker">LIVE PHARMACY WORKSPACE</span>

        <h2>
            Sales, purchases and inventory are connected in one system.
        </h2>

        <p>
            Monitor daily revenue, customer dues, supplier balances,
            stock levels and expiry risk using live Supabase data.
        </p>

        <div class="welcome-actions">
            <a href="pos" class="button button-light">
                Open point of sale
            </a>

            <a href="inventory" class="button button-ghost">
                Review inventory
            </a>
        </div>
    </div>

    <div class="welcome-visual" aria-hidden="true">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>

        <div class="medical-cross">
            <span></span>
            <span></span>
        </div>
    </div>
</section>

<section class="metric-grid">
    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-icon metric-green">৳</span>

            <span class="metric-trend positive">
                Live
            </span>
        </div>

        <span class="metric-label">Today's sales</span>

        <strong class="metric-value">
            ৳@todaySalesValue.ToString("N2")
        </strong>

        <small>
            ৳@(todayPaidValue.ToString("N2")) received today ·
            ৳@(todayReturnsValue.ToString("N2")) returned today
        </small>
    </article>

    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-icon metric-blue">▣</span>

            <span class="metric-trend neutral">
                Today
            </span>
        </div>

        <span class="metric-label">Invoices</span>

        <strong class="metric-value">
            @todayInvoiceCount
        </strong>

        <small>
            @todayUnitsSold medicine units sold
        </small>
    </article>

    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-icon metric-amber">!</span>

            <span class="metric-trend
                @(lowStockCount > 0 ? "warning" : "positive")">
                @(lowStockCount > 0 ? "Attention" : "Healthy")
            </span>
        </div>

        <span class="metric-label">Low stock</span>

        <strong class="metric-value">
            @lowStockCount
        </strong>

        <small>Medicines at or below reorder level</small>
    </article>

    <article class="metric-card">
        <div class="metric-card-top">
            <span class="metric-icon metric-red">⌛</span>

            <span class="metric-trend
                @(expiringSoonCount > 0 ? "warning" : "positive")">
                90 days
            </span>
        </div>

        <span class="metric-label">Expiring soon</span>

        <strong class="metric-value">
            @expiringSoonCount
        </strong>

        <small>Available batches approaching expiry</small>
    </article>
</section>

<div class="dashboard-grid">
    <section class="dashboard-panel quick-actions-panel">
        <div class="panel-heading">
            <div>
                <h2>Quick actions</h2>
                <p>Start common pharmacy operations.</p>
            </div>
        </div>

        <div class="quick-action-grid">
            <a class="quick-action" href="pos">
                <span class="quick-action-icon action-teal">▣</span>

                <span>
                    <strong>New sale</strong>
                    <small>Open point of sale</small>
                </span>
            </a>

            <a class="quick-action" href="medicines">
                <span class="quick-action-icon action-purple">✚</span>

                <span>
                    <strong>Add medicine</strong>
                    <small>Create catalog item</small>
                </span>
            </a>

            <a class="quick-action" href="purchases">
                <span class="quick-action-icon action-blue">↓</span>

                <span>
                    <strong>Receive purchase</strong>
                    <small>Add supplier stock</small>
                </span>
            </a>

            <a class="quick-action" href="inventory">
                <span class="quick-action-icon action-orange">▤</span>

                <span>
                    <strong>Inventory</strong>
                    <small>Review batches and expiry</small>
                </span>
            </a>

            <a class="quick-action" href="customers">
                <span class="quick-action-icon action-pink">♙</span>

                <span>
                    <strong>Customers</strong>
                    <small>Manage customer accounts</small>
                </span>
            </a>

            <a class="quick-action" href="suppliers">
                <span class="quick-action-icon action-indigo">▱</span>

                <span>
                    <strong>Suppliers</strong>
                    <small>Manage supplier accounts</small>
                </span>
            </a>

            <a class="quick-action" href="supplier-returns">
                <span class="quick-action-icon action-orange">↪</span>

                <span>
                    <strong>Supplier returns</strong>
                    <small>Reverse purchases and stock</small>
                </span>
            </a>
        </div>
    </section>

    <section class="dashboard-panel inventory-health-panel">
        <div class="panel-heading">
            <div>
                <h2>Inventory health</h2>
                <p>Live medicine availability status.</p>
            </div>

            <a href="inventory">View inventory</a>
        </div>

        <div class="health-list">
            <div class="health-row">
                <div class="health-label">
                    <span>Healthy stock</span>
                    <strong>@healthyStockCount medicines</strong>
                </div>

                <div class="progress-track">
                    <span class="progress-value healthy-progress"
                          style="@($"width: {HealthyPercent}%")">
                    </span>
                </div>
            </div>

            <div class="health-row">
                <div class="health-label">
                    <span>Low stock</span>
                    <strong>@lowStockCount medicines</strong>
                </div>

                <div class="progress-track">
                    <span class="progress-value low-progress"
                          style="@($"width: {LowStockPercent}%")">
                    </span>
                </div>
            </div>

            <div class="health-row">
                <div class="health-label">
                    <span>Out of stock</span>
                    <strong>@outOfStockCount medicines</strong>
                </div>

                <div class="progress-track">
                    <span class="progress-value empty-progress"
                          style="@($"width: {OutOfStockPercent}%")">
                    </span>
                </div>
            </div>
        </div>

        <div class="inventory-empty">
            <span class="empty-icon">▤</span>

            <strong>
                @totalAvailableUnits available units
            </strong>

            <p>
                Across @activeBatchCount active
                @(activeBatchCount == 1 ? "batch" : "batches")
                and @inventoryMedicineCount active
                @(inventoryMedicineCount == 1
                    ? "medicine"
                    : "medicines").
            </p>

            <a href="inventory">Review batch inventory</a>
        </div>
    </section>
</div>

<div class="dashboard-grid lower-grid">
    <section class="dashboard-panel recent-sales-panel">
        <div class="panel-heading">
            <div>
                <h2>Recent sales</h2>
                <p>Your latest pharmacy transactions.</p>
            </div>

            <a href="pos">New sale</a>
        </div>

        <div class="responsive-table">
            <table>
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Customer</th>
                        <th>Payment</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (isLoading)
                    {
                        <tr class="empty-table-row">
                            <td colspan="5">
                                <span>Loading recent sales...</span>
                            </td>
                        </tr>
                    }
                    else if (recentSales.Count == 0)
                    {
                        <tr class="empty-table-row">
                            <td colspan="5">
                                <span>No sales have been recorded yet.</span>
                                <a href="pos">Create the first sale</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var sale in recentSales)
                        {
                            <tr @key="sale.Id">
                                <td>
                                    <a class="invoice-table-link"
                                       href="@($"/sales/{sale.Id}/invoice")">
                                        @sale.InvoiceNumber
                                    </a>
                                    <small>
                                        @(sale.SoldAtUtc
                                            .ToLocalTime()
                                            .ToString("dd MMM, hh:mm tt"))
                                    </small>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        sale.CustomerName)
                                        ? "Walk-in customer"
                                        : sale.CustomerName)
                                </td>

                                <td>
                                    @FormatPaymentMethod(
                                        sale.PaymentMethod)
                                </td>

                                <td>
                                    ৳@sale.GrandTotal.ToString("N2")
                                </td>

                                <td>
                                    <span class="metric-trend
                                        @GetSaleStatusClass(sale.Status)">
                                        @FormatSaleStatus(sale.Status)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="dashboard-panel alert-panel">
        <div class="panel-heading">
            <div>
                <h2>Business snapshot</h2>
                <p>Live account and operational totals.</p>
            </div>

            <span class="progress-count">Live</span>
        </div>

        <div class="setup-list">
            <div class="setup-item complete">
                <span class="setup-check">৳</span>

                <div>
                    <strong>
                        ৳@customerReceivable.ToString("N2")
                        customer receivable
                    </strong>

                    <small>
                        Outstanding balances from
                        @activeCustomerCount active customers.
                    </small>
                </div>
            </div>

            <div class="setup-item complete">
                <span class="setup-check">↓</span>

                <div>
                    <strong>
                        ৳@supplierPayable.ToString("N2")
                        supplier payable
                    </strong>

                    <small>
                        Current balances across
                        @activeSupplierCount active suppliers.
                    </small>
                </div>
            </div>

            <div class="setup-item complete">
                <span class="setup-check">↪</span>

                <div>
                    <strong>
                        ৳@todaySupplierReturnsValue.ToString("N2")
                        returned to suppliers today
                    </strong>

                    <small>
                        @todaySupplierReturnCount
                        supplier-return
                        @(todaySupplierReturnCount == 1
                            ? "transaction"
                            : "transactions")
                        recorded today.
                    </small>
                </div>
            </div>

            <div class="setup-item complete">
                <span class="setup-check">Rx</span>

                <div>
                    <strong>
                        @inventoryMedicineCount active medicines
                    </strong>

                    <small>
                        @totalAvailableUnits sellable units currently available.
                    </small>
                </div>
            </div>

            <div class="setup-item complete">
                <span class="setup-check">✓</span>

                <div>
                    <strong>Core operations connected</strong>

                    <small>
                        Medicines, purchases, inventory, sales,
                        customer returns, supplier returns and account
                        balances are live.
                    </small>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private readonly List<Sale> recentSales = [];

    private string dashboardDateText =
        DateTime.Now.ToString("dddd, d MMMM yyyy")
            .ToUpperInvariant();

    private string greetingText = "Welcome";

    private string displayName = "Owner";

    private string? loadError;

    private decimal todaySalesValue;
    private decimal todayPaidValue;
    private decimal todayReturnsValue;
    private decimal todaySupplierReturnsValue;
    private decimal customerReceivable;
    private decimal supplierPayable;

    private int todayInvoiceCount;
    private int todaySupplierReturnCount;
    private int todayUnitsSold;

    private int inventoryMedicineCount;
    private int healthyStockCount;
    private int lowStockCount;
    private int outOfStockCount;
    private int expiringSoonCount;

    private int totalAvailableUnits;
    private int activeBatchCount;
    private int activeCustomerCount;
    private int activeSupplierCount;

    private bool isLoading = true;

    private int HealthyPercent =>
        inventoryMedicineCount == 0
            ? 0
            : (int)Math.Round(
                healthyStockCount * 100d /
                inventoryMedicineCount);

    private int LowStockPercent =>
        inventoryMedicineCount == 0
            ? 0
            : (int)Math.Round(
                lowStockCount * 100d /
                inventoryMedicineCount);

    private int OutOfStockPercent =>
        inventoryMedicineCount == 0
            ? 0
            : (int)Math.Round(
                outOfStockCount * 100d /
                inventoryMedicineCount);

    protected override async Task OnInitializedAsync()
    {
        await LoadDisplayNameAsync();
        SetGreeting();

        try
        {
            using var scope = ScopeFactory.CreateScope();

            var database = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            var localToday = DateTime.Today;

            var todayStartUtc =
                localToday.ToUniversalTime();

            var tomorrowStartUtc =
                localToday.AddDays(1).ToUniversalTime();

            var todaySalesQuery = database.Sales
                .AsNoTracking()
                .Where(sale =>
                    sale.SoldAtUtc >= todayStartUtc &&
                    sale.SoldAtUtc < tomorrowStartUtc &&
                    sale.Status != SaleStatus.Cancelled &&
                    sale.Status != SaleStatus.Refunded);

            todayInvoiceCount =
                await todaySalesQuery.CountAsync();

            todaySalesValue =
                await todaySalesQuery.SumAsync(
                    sale => (decimal?)sale.GrandTotal) ?? 0;

            todayPaidValue =
                await todaySalesQuery.SumAsync(
                    sale => (decimal?)sale.PaidAmount) ?? 0;

            todayReturnsValue =
                await database.SaleReturns
                    .AsNoTracking()
                    .Where(saleReturn =>
                        saleReturn.ReturnedAtUtc >= todayStartUtc &&
                        saleReturn.ReturnedAtUtc < tomorrowStartUtc)
                    .SumAsync(saleReturn =>
                        (decimal?)saleReturn.GrossReturnAmount) ?? 0;

            var todaySupplierReturnsQuery =
                database.SupplierReturns
                    .AsNoTracking()
                    .Where(supplierReturn =>
                        supplierReturn.ReturnedAtUtc >= todayStartUtc &&
                        supplierReturn.ReturnedAtUtc < tomorrowStartUtc);

            todaySupplierReturnCount =
                await todaySupplierReturnsQuery.CountAsync();

            todaySupplierReturnsValue =
                await todaySupplierReturnsQuery.SumAsync(
                    supplierReturn =>
                        (decimal?)supplierReturn
                            .GrossReturnAmount) ?? 0;

            var todaySaleItems =
                await database.SaleItems
                    .AsNoTracking()
                    .Include(item => item.ReturnItems)
                    .Where(item =>
                        item.Sale != null &&
                        item.Sale.SoldAtUtc >= todayStartUtc &&
                        item.Sale.SoldAtUtc < tomorrowStartUtc &&
                        item.Sale.Status != SaleStatus.Cancelled &&
                        item.Sale.Status != SaleStatus.Refunded)
                    .ToListAsync();

            todayUnitsSold =
                todaySaleItems.Sum(item =>
                    Math.Max(
                        0,
                        item.Quantity -
                        item.ReturnItems.Sum(returnItem =>
                            returnItem.Quantity)));

            recentSales.AddRange(
                await database.Sales
                    .AsNoTracking()
                    .OrderByDescending(sale => sale.SoldAtUtc)
                    .Take(8)
                    .ToListAsync());

            var medicines = await database.Medicines
                .AsNoTracking()
                .Where(medicine => medicine.IsActive)
                .Include(medicine => medicine.Batches)
                .OrderBy(medicine => medicine.BrandName)
                .ToListAsync();

            inventoryMedicineCount = medicines.Count;

            var today = DateTime.Today;
            var expiryLimit = today.AddDays(90);

            foreach (var medicine in medicines)
            {
                var availableStock = medicine.Batches
                    .Where(batch =>
                        batch.AvailableQuantity > 0 &&
                        !batch.IsQuarantined &&
                        batch.ExpiryDate.Date >= today)
                    .Sum(batch => batch.AvailableQuantity);

                totalAvailableUnits += availableStock;

                if (availableStock == 0)
                {
                    outOfStockCount++;
                }
                else if (availableStock <= medicine.ReorderLevel)
                {
                    lowStockCount++;
                }
                else
                {
                    healthyStockCount++;
                }
            }

            activeBatchCount = medicines
                .SelectMany(medicine => medicine.Batches)
                .Count(batch =>
                    batch.AvailableQuantity > 0 &&
                    !batch.IsQuarantined &&
                    batch.ExpiryDate.Date >= today);

            expiringSoonCount = medicines
                .SelectMany(medicine => medicine.Batches)
                .Count(batch =>
                    batch.AvailableQuantity > 0 &&
                    !batch.IsQuarantined &&
                    batch.ExpiryDate.Date >= today &&
                    batch.ExpiryDate.Date <= expiryLimit);

            activeCustomerCount =
                await database.Customers
                    .AsNoTracking()
                    .CountAsync(customer => customer.IsActive);

            customerReceivable =
                await database.Customers
                    .AsNoTracking()
                    .SumAsync(customer =>
                        (decimal?)customer.CurrentBalance) ?? 0;

            activeSupplierCount =
                await database.Suppliers
                    .AsNoTracking()
                    .CountAsync(supplier => supplier.IsActive);

            supplierPayable =
                await database.Suppliers
                    .AsNoTracking()
                    .SumAsync(supplier =>
                        (decimal?)supplier.CurrentBalance) ?? 0;
        }
        catch (Exception exception)
        {
            loadError =
                "The live dashboard could not be loaded: " +
                exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDisplayNameAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var identityName =
            authenticationState.User.Identity?.Name;

        displayName =
            FormatDisplayName(identityName);
    }

    private static string FormatDisplayName(
        string? identityName)
    {
        if (string.IsNullOrWhiteSpace(identityName))
        {
            return "Owner";
        }

        var localPart =
            identityName.Split('@', 2)[0];

        var firstSegment =
            localPart.Split(
                    new[] { '.', '_', '-' },
                    StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault() ?? localPart;

        var lettersOnly =
            new string(
                firstSegment
                    .TakeWhile(char.IsLetter)
                    .ToArray());

        var cleanedName =
            string.IsNullOrWhiteSpace(lettersOnly)
                ? firstSegment
                : lettersOnly;

        if (string.IsNullOrWhiteSpace(cleanedName))
        {
            return "Owner";
        }

        return char.ToUpperInvariant(cleanedName[0]) +
            cleanedName[1..].ToLowerInvariant();
    }

    private void SetGreeting()
    {
        greetingText = DateTime.Now.Hour switch
        {
            < 12 => "Good morning",
            < 17 => "Good afternoon",
            _ => "Good evening"
        };
    }

    private static string FormatPaymentMethod(
        PaymentMethod paymentMethod)
    {
        return paymentMethod switch
        {
            PaymentMethod.MobileBanking =>
                "Mobile banking",
            PaymentMethod.BankTransfer =>
                "Bank transfer",
            _ => paymentMethod.ToString()
        };
    }

    private static string FormatSaleStatus(
        SaleStatus status)
    {
        return status switch
        {
            SaleStatus.PartiallyPaid =>
                "Partially paid",
            _ => status.ToString()
        };
    }

    private static string GetSaleStatusClass(
        SaleStatus status)
    {
        return status switch
        {
            SaleStatus.Completed => "positive",
            SaleStatus.Due => "warning",
            SaleStatus.PartiallyPaid => "neutral",
            SaleStatus.Cancelled => "warning",
            SaleStatus.Refunded => "neutral",
            _ => "neutral"
        };
    }
}
