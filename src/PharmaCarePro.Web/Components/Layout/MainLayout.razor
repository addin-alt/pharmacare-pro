@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="topbar-search">
                <span aria-hidden="true">⌕</span>
                <input type="search"
                       placeholder="Search medicines, invoices, customers..."
                       aria-label="Search PharmaCare Pro" />
            </div>

            <div class="topbar-actions">
                <span class="environment-pill">
                    <span class="status-dot"></span>
                    Supabase connected
                </span>

                <AuthorizeView>
                    <Authorized>
                        <a class="user-chip" href="Account/Manage">
                            <span class="user-avatar">A</span>
                            <span>@context.User.Identity?.Name</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="topbar-login" href="Account/Login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="content-area">
            @Body
        </main>

        <footer class="app-footer">
            <span>PharmaCare Pro</span>
            <span>Developed by Addin Alt</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
