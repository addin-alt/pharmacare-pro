@implements IDisposable
@inject NavigationManager NavigationManager

<div class="sidebar-brand">
    <div class="brand-mark">Rx</div>
    <div>
        <div class="brand-name">PharmaCare</div>
        <div class="brand-edition">PRO</div>
    </div>
</div>

<div class="branch-card">
    <span class="branch-icon">⌂</span>
    <div>
        <strong>Main Pharmacy</strong>
        <small>Primary branch</small>
    </div>
    <span class="branch-chevron">⌄</span>
</div>

<nav class="sidebar-nav">
    <div class="nav-section-label">Workspace</div>

    <NavLink class="side-nav-link" href="" Match="NavLinkMatch.All">
        <span class="side-nav-icon">▦</span>
        <span>Dashboard</span>
    </NavLink>

    <NavLink class="side-nav-link" href="pos">
        <span class="side-nav-icon">▣</span>
        <span>Point of Sale</span>
        <span class="nav-badge">POS</span>
    </NavLink>

    <div class="nav-section-label">Pharmacy</div>

    <NavLink class="side-nav-link" href="medicines">
        <span class="side-nav-icon">✚</span>
        <span>Medicines</span>
    </NavLink>

    <NavLink class="side-nav-link" href="inventory">
        <span class="side-nav-icon">▤</span>
        <span>Inventory</span>
    </NavLink>

    <NavLink class="side-nav-link" href="purchases">
        <span class="side-nav-icon">↓</span>
        <span>Purchases</span>
    </NavLink>

    <NavLink class="side-nav-link" href="prescriptions">
        <span class="side-nav-icon">⌑</span>
        <span>Prescriptions</span>
    </NavLink>

    <NavLink class="side-nav-link" href="customers">
        <span class="side-nav-icon">♙</span>
        <span>Customers</span>
    </NavLink>

    <NavLink class="side-nav-link" href="suppliers">
        <span class="side-nav-icon">▱</span>
        <span>Suppliers</span>
    </NavLink>

    <div class="nav-section-label">Business</div>

    <NavLink class="side-nav-link" href="reports">
        <span class="side-nav-icon">↗</span>
        <span>Reports</span>
    </NavLink>

    <NavLink class="side-nav-link" href="settings">
        <span class="side-nav-icon">⚙</span>
        <span>Settings</span>
    </NavLink>
</nav>

<div class="sidebar-account">
    <AuthorizeView>
        <Authorized>
            <a class="account-link" href="Account/Manage">
                <span class="account-avatar">A</span>
                <span>
                    <strong>@context.User.Identity?.Name</strong>
                    <small>Manage account</small>
                </span>
            </a>

            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button class="logout-button" type="submit">Sign out</button>
            </form>
        </Authorized>

        <NotAuthorized>
            <div class="guest-actions">
                <a class="sidebar-signin" href="Account/Login">Sign in</a>
                <a class="sidebar-register" href="Account/Register">Create account</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(args.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
